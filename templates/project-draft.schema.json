{
  "$ref": "#/definitions/Draft",
  "definitions": {
    "Draft": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "draft_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "draft_revision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "project": {
          "type": "object",
          "properties": {
            "project_id": {
              "$ref": "#/definitions/Draft/properties/draft_id"
            },
            "name": {
              "type": "string",
              "maxLength": 500
            },
            "goal": {
              "type": "string",
              "maxLength": 20000
            },
            "context": {
              "$ref": "#/definitions/Draft/properties/project/properties/goal"
            },
            "target_date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "framework": {
              "type": "string",
              "enum": [
                "dependencies",
                "deadlines",
                "milestones",
                "sprints",
                "checklist",
                "adaptive"
              ]
            },
            "instructions": {
              "$ref": "#/definitions/Draft/properties/project/properties/goal"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "updated_at": {
              "$ref": "#/definitions/Draft/properties/project/properties/created_at"
            }
          },
          "required": [
            "project_id",
            "name",
            "goal",
            "context",
            "target_date",
            "framework",
            "instructions",
            "revision"
          ],
          "additionalProperties": false
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "$ref": "#/definitions/Draft/properties/draft_id"
              },
              "project_id": {
                "$ref": "#/definitions/Draft/properties/draft_id"
              },
              "title": {
                "type": "string",
                "maxLength": 500
              },
              "notes": {
                "$ref": "#/definitions/Draft/properties/project/properties/goal"
              },
              "status": {
                "type": "string",
                "enum": [
                  "Not started",
                  "In progress",
                  "Blocked",
                  "Complete",
                  "Superseded"
                ]
              },
              "estimated_minutes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "due_date": {
                "$ref": "#/definitions/Draft/properties/project/properties/target_date"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Draft/properties/draft_id"
                },
                "maxItems": 500
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "user",
                  "AI",
                  "hybrid",
                  "imported"
                ]
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "archived": {
                "type": "boolean"
              },
              "applicability": {
                "type": "string",
                "enum": [
                  "applicable",
                  "pending",
                  "not_applicable"
                ]
              },
              "condition": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "diagnostic_task_id": {
                        "$ref": "#/definitions/Draft/properties/draft_id"
                      },
                      "outcome": {
                        "type": "string",
                        "enum": [
                          "unknown",
                          "required",
                          "not_required"
                        ]
                      }
                    },
                    "required": [
                      "diagnostic_task_id",
                      "outcome"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "parent_task_id": {
                "$ref": "#/definitions/Draft/properties/draft_id"
              },
              "display_alias": {
                "type": "string",
                "maxLength": 100
              },
              "group": {
                "type": "string",
                "maxLength": 200
              },
              "cost_estimate": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "amount": {
                        "type": "number",
                        "minimum": 0
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$"
                      },
                      "basis": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      }
                    },
                    "required": [
                      "amount",
                      "currency",
                      "basis"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "created_at": {
                "$ref": "#/definitions/Draft/properties/project/properties/created_at"
              },
              "updated_at": {
                "$ref": "#/definitions/Draft/properties/project/properties/created_at"
              }
            },
            "required": [
              "task_id",
              "project_id",
              "title",
              "notes",
              "status",
              "estimated_minutes",
              "due_date",
              "depends_on",
              "provenance",
              "version",
              "archived",
              "applicability",
              "condition"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Draft/properties/draft_id"
          },
          "maxItems": 500
        },
        "splits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "parent_task_id": {
                "$ref": "#/definitions/Draft/properties/draft_id"
              },
              "child_task_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Draft/properties/draft_id"
                },
                "minItems": 2,
                "maxItems": 500
              },
              "edges_reviewed": {
                "type": "boolean"
              }
            },
            "required": [
              "parent_task_id",
              "child_task_ids",
              "edges_reviewed"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "split_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "$ref": "#/definitions/Draft/properties/draft_id"
              },
              "description": {
                "$ref": "#/definitions/Draft/properties/project/properties/goal"
              }
            },
            "required": [
              "task_id",
              "description"
            ],
            "additionalProperties": false
          },
          "maxItems": 500,
          "default": []
        },
        "instruction_scope": {
          "type": "string",
          "enum": [
            "this_submission",
            "this_project",
            "future_projects"
          ]
        },
        "additional_instructions": {
          "$ref": "#/definitions/Draft/properties/project/properties/goal"
        }
      },
      "required": [
        "schema_version",
        "draft_id",
        "draft_revision",
        "expected_revision",
        "project",
        "tasks",
        "exclusions",
        "splits",
        "instruction_scope",
        "additional_instructions"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}