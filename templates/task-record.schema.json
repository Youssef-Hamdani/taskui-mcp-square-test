{
  "$ref": "#/definitions/Task",
  "definitions": {
    "Task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "project_id": {
          "$ref": "#/definitions/Task/properties/task_id"
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "maxLength": 20000
        },
        "status": {
          "type": "string",
          "enum": [
            "Not started",
            "In progress",
            "Blocked",
            "Complete",
            "Superseded"
          ]
        },
        "estimated_minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "due_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Task/properties/task_id"
          },
          "maxItems": 500
        },
        "provenance": {
          "type": "string",
          "enum": [
            "user",
            "AI",
            "hybrid",
            "imported"
          ]
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "archived": {
          "type": "boolean"
        },
        "applicability": {
          "type": "string",
          "enum": [
            "applicable",
            "pending",
            "not_applicable"
          ]
        },
        "condition": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "diagnostic_task_id": {
                  "$ref": "#/definitions/Task/properties/task_id"
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "unknown",
                    "required",
                    "not_required"
                  ]
                }
              },
              "required": [
                "diagnostic_task_id",
                "outcome"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_task_id": {
          "$ref": "#/definitions/Task/properties/task_id"
        },
        "display_alias": {
          "type": "string",
          "maxLength": 100
        },
        "group": {
          "type": "string",
          "maxLength": 200
        },
        "cost_estimate": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "basis": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "amount",
                "currency",
                "basis"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "$ref": "#/definitions/Task/properties/created_at"
        }
      },
      "required": [
        "task_id",
        "project_id",
        "title",
        "notes",
        "status",
        "estimated_minutes",
        "due_date",
        "depends_on",
        "provenance",
        "version",
        "archived",
        "applicability",
        "condition"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}